# Variables d'environnement de SpendEdge.
# Copiez ce fichier en « .env.local » (jamais commité) et remplissez les valeurs.
# En local, « npm run env:local » le remplit automatiquement depuis Supabase local.
# En production (Vercel) : Settings > Environment Variables, mêmes noms.

# Adresse publique du site, sans « / » final.
# Local : http://localhost:3000 · Production : https://votre-domaine.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API Keys (ou « npx supabase status » en local).
# URL du projet. Visible dans le navigateur : ce n'est pas un secret.
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique (sb_publishable_...). Visible dans le navigateur : la sécurité repose sur la RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET. Clé secrète (sb_secret_...). Contourne la RLS : uniquement côté serveur.
# Ne jamais la préfixer par NEXT_PUBLIC_, ne jamais la partager ni la commiter.
SUPABASE_SECRET_KEY=

# SECRET. Sert à transformer les adresses IP en empreintes non réversibles (anti-abus).
# 32 caractères minimum. Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=
